# Miden Assembly - Multi-Program Benchmark
# Stack inputs: [n, program_id] (program_id at top, then n)
# Output: Result of the selected program
#
# Program IDs:
# 0: Fibonacci(n)
# 1: Sum(n)
# 2: Factorial(n)

begin
    # Stack: [program_id, n, ...]
    
    # Check program_id
    dup
    push.0
    eq
    if.true
        # Program 0: Fibonacci
        drop    # Drop program_id
        exec.fib
    else
        dup
        push.1
        eq
        if.true
            # Program 1: Sum
            drop # Drop program_id
            exec.sum
        else
            dup
            push.2
            eq
            if.true
                # Program 2: Factorial
                drop # Drop program_id
                exec.factorial
            else
                # Unknown program, return 0
                drop
                drop
                push.0
            end
        end
    end
end

# ------------------------------------------------------------------
# Procedure: Fibonacci
# Input: [n]
# Output: [fib(n)]
# ------------------------------------------------------------------
proc.fib
    # Check base cases
    dup
    push.0
    eq
    if.true
        # n == 0, return 0
    else
        dup
        push.1
        eq
        if.true
            # n == 1, return 1
            drop
            push.1
        else
            # n >= 2
            # Initialize: a=1, b=0
            push.0  # b
            push.1  # a
            # Stack: [a, b, n]
            
            # Move n to top to loop
            movup.2
            push.1
            sub     # loop n-1 times
            
            # Stack: [count, a, b]
            while.true
                # Calculate next term
                movdn.2     # [a, b, count]
                dup         # [a, a, b, count]
                movdn.2     # [a, b, a, count]
                add         # [a+b, a, count]
                
                # Move count to top
                movup.2     # [count, new_a, new_b]
                push.1
                sub         # [count-1, new_a, new_b]
                dup
                push.0
                gt
            end
            
            # Cleanup
            drop        # Drop count (0)
            swap        # [new_b, new_a] -> [result, prev]
            drop        # [result]
        end
    end
end

# ------------------------------------------------------------------
# Procedure: Sum
# Input: [n]
# Output: [sum(n) = n*(n+1)/2]
# ------------------------------------------------------------------
proc.sum
    dup
    push.1
    add
    mul
    push.2
    div
end

# ------------------------------------------------------------------
# Procedure: Factorial
# Input: [n]
# Output: [n!]
# ------------------------------------------------------------------
proc.factorial
    # Base case: 0! = 1
    dup
    push.0
    eq
    if.true
        drop
        push.1
    else
        # Accumulator = 1
        push.1
        swap    # [n, acc]
        
        # Loop while n > 1
        dup
        push.1
        gt
        while.true
            # Stack: [n, acc]
            dup         # [n, n, acc]
            movup.2     # [acc, n, n]
            mul         # [acc*n, n]
            swap        # [n, new_acc]
            
            push.1
            sub         # [n-1, new_acc]
            
            dup
            push.1
            gt
        end
        # Stack: [1, result]
        drop
    end
end
