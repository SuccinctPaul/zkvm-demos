// Factorial computation in Cairo-M
// Computes n! (n factorial)
//
// Usage:
//   cairo-m-compiler --input factorial.cm --output factorial.json
//   cairo-m-runner factorial.json --entrypoint factorial --arguments 10

// Factorial function - computes n!
// Input: n (felt) - number to compute factorial of
// Output: n! = 1 * 2 * 3 * ... * n
func factorial(n: felt) -> felt {
    // Base case
    if n <= 1 {
        return 1;
    }
    
    // Iterative computation
    let mut result: felt = 1;
    let mut i: felt = 2;
    
    while i <= n {
        result = result * i;
        i = i + 1;
    }
    
    return result;
}

// Entry point
func main(input: felt) -> felt {
    return factorial(input);
}

