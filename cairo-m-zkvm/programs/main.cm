// Cairo-M Multi-Program Dispatcher
// Implements multiple benchmark programs for zkVM benchmarking
// Note: Casting only supported u32 -> felt, not felt -> u32

// Pre-computed powers of 2 for bit operations
const POW2 = [1u32, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072, 262144, 524288, 1048576, 2097152, 4194304, 8388608, 16777216, 33554432, 67108864, 134217728, 268435456, 536870912, 1073741824, 2147483648];

// ==================================================================================
// FIBONACCI
// ==================================================================================

/// Compute the nth Fibonacci number iteratively
/// Input n is passed as felt but we use u32 counter
fn fibonacci(n: felt) -> u32 {
    if n == 0 {
        return 0u32;
    }
    if n == 1 {
        return 1u32;
    }
    
    let a: u32 = 0u32;
    let b: u32 = 1u32;
    
    // Use felt counter, compare with felt
    for (let i: felt = 2; i != n + 1; i = i + 1) {
        let temp: u32 = a + b;
        a = b;
        b = temp;
    }
    
    return b;
}

// ==================================================================================
// SUM
// ==================================================================================

/// Compute sum of integers from 1 to n
/// Uses u32 for accumulator and counter
fn sum(n: felt) -> u32 {
    let total: u32 = 0u32;
    let counter: u32 = 1u32;
    
    // Count up using u32, check against felt n
    for (let i: felt = 1; i != n + 1; i = i + 1) {
        total = total + counter;
        counter = counter + 1u32;
    }
    
    return total;
}

// ==================================================================================
// FACTORIAL
// ==================================================================================

/// Compute n! (factorial)
fn factorial(n: felt) -> u32 {
    if n == 0 {
        return 1u32;
    }
    if n == 1 {
        return 1u32;
    }
    
    let result: u32 = 1u32;
    let multiplier: u32 = 2u32;
    
    for (let i: felt = 2; i != n + 1; i = i + 1) {
        result = result * multiplier;
        multiplier = multiplier + 1u32;
    }
    
    return result;
}

// ==================================================================================
// IS PRIME (simplified)
// ==================================================================================

/// Helper: compute x mod y using division
fn mod_u32(x: u32, y: u32) -> u32 {
    return x - (x / y) * y;
}

/// Check if n is a prime number
fn isprime(n: felt) -> u32 {
    if n == 0 {
        return 0u32;
    }
    if n == 1 {
        return 0u32;
    }
    if n == 2 {
        return 1u32;
    }
    if n == 3 {
        return 1u32;
    }
    
    // We need n as u32 - use a workaround by counting up
    // This only works for small n values
    let n_u32: u32 = 0u32;
    for (let j: felt = 0; j != n; j = j + 1) {
        n_u32 = n_u32 + 1u32;
    }
    
    // Check if divisible by 2
    if mod_u32(n_u32, 2u32) == 0u32 {
        return 0u32;
    }
    
    // Check odd divisors
    let half: u32 = n_u32 / 2u32;
    let divisor: u32 = 3u32;
    for (let i: u32 = 3u32; i != half + 1u32; i = i + 2u32) {
        if mod_u32(n_u32, divisor) == 0u32 {
            return 0u32;
        }
        divisor = divisor + 2u32;
    }
    
    return 1u32;
}

// ==================================================================================
// POPCOUNT (population count)
// ==================================================================================

/// Count set bits (1s) in n
fn popcount(n: felt) -> u32 {
    // Convert felt to u32 by counting
    let value: u32 = 0u32;
    for (let j: felt = 0; j != n; j = j + 1) {
        value = value + 1u32;
    }
    
    let count: u32 = 0u32;
    
    // Count bits by checking each bit position
    for (let i: felt = 0; i != 32; i = i + 1) {
        // Check if bit at current position is set
        let shifted: u32 = value & 1u32;
        if shifted == 1u32 {
            count = count + 1u32;
        }
        value = value / 2u32;
    }
    
    return count;
}

// ==================================================================================
// HASH (simplified)
// ==================================================================================

/// Compute a simple hash of n iterations
fn hash(n: felt) -> u32 {
    let hash_value: u32 = 2166136261u32;
    let prime: u32 = 16777619u32;
    
    if n == 0 {
        return hash_value;
    }
    
    let byte: u32 = 0u32;
    
    for (let i: felt = 0; i != n; i = i + 1) {
        // Early exit at 256 iterations
        if byte == 256u32 {
            return hash_value;
        }
        hash_value = hash_value ^ byte;
        hash_value = hash_value * prime;
        byte = byte + 1u32;
    }
    
    return hash_value;
}

// ==================================================================================
// SIGNATURE (simplified)
// ==================================================================================

/// Simulate signature verification workload
fn signature(n: felt) -> u32 {
    if n == 0 {
        return 1u32;
    }
    
    let result: u32 = 1u32;
    let counter: u32 = 0u32;
    
    for (let i: felt = 0; i != n; i = i + 1) {
        if counter == 100u32 {
            return 1u32;
        }
        result = result * 65537u32 + counter;
        // Simplified modulo using wrapping (u32 will wrap naturally)
        counter = counter + 1u32;
    }
    
    return 1u32;
}

// ==================================================================================
// MAIN
// ==================================================================================

fn main(n: felt) -> u32 {
    return fibonacci(n);
}
