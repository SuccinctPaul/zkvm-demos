// Fibonacci computation in Cairo-M
// This program computes the nth Fibonacci number using an iterative approach
// optimized for the M31 field arithmetic

// Main fibonacci function
// Takes n as input and returns the nth Fibonacci number
func fibonacci(n: felt) -> felt {
    // Base cases
    if n == 0 {
        return 0;
    }
    if n == 1 {
        return 1;
    }
    
    // Iterative computation for n >= 2
    let a = 0;
    let b = 1;
    let i = 2;
    
    // Loop until we reach n
    while i <= n {
        let temp = a + b;
        a = b;
        b = temp;
        i = i + 1;
    }
    
    return b;
}

// Alternative recursive implementation (less efficient but demonstrates recursion)
func fibonacci_recursive(n: felt) -> felt {
    if n == 0 {
        return 0;
    }
    if n == 1 {
        return 1;
    }
    return fibonacci_recursive(n - 1) + fibonacci_recursive(n - 2);
}

// Helper function to verify Fibonacci properties
// Verifies: F(n) = F(n-1) + F(n-2)
func verify_fibonacci(n: felt, fn_val: felt, fn1_val: felt, fn2_val: felt) -> bool {
    if n < 2 {
        return true;
    }
    return fn_val == fn1_val + fn2_val;
}

// Entry point that can be called from the host
func main(input: felt) -> felt {
    // Compute Fibonacci number
    let result = fibonacci(input);
    
    // Return the result
    return result;
}

