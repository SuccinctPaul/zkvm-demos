# Multi-stage SP1 ZKVM Dockerfile - Using shared base image
FROM zkvm-base:latest AS base

# Set SP1 environment variable
ENV SP1_DIR="/root/.sp1"

# Copy and run SP1 SDK installer script
COPY scripts/sdk_installers/install_sp1_sdk.sh /tmp/install_sp1_sdk.sh
RUN chmod +x /tmp/install_sp1_sdk.sh && /tmp/install_sp1_sdk.sh \
    && rm -f /tmp/install_sp1_sdk.sh

# Add SP1 to PATH
ENV PATH="${SP1_DIR}/bin:$PATH"

# Build stage - separate from runtime
FROM base AS builder

WORKDIR /workspace

# Copy only necessary files for build
COPY Cargo.toml Cargo.lock ./
COPY common/ ./common/
COPY fib/ ./fib/
COPY sp1-zkvm/sp1-host/Cargo.toml ./sp1-zkvm/sp1-host/
COPY sp1-zkvm/sp1-guest/ ./sp1-zkvm/sp1-guest/

# Build dependencies first (better caching)
RUN cd sp1-zkvm/sp1-host && cargo build --release --locked

# Copy source code and build
COPY sp1-zkvm/sp1-host/src/ ./sp1-zkvm/sp1-host/src/
RUN cd sp1-zkvm/sp1-host && cargo build --release --locked

# Runtime stage - minimal image
FROM ubuntu:22.04 AS runtime

# Install only runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy Rust and SP1 tools from builder
COPY --from=builder /usr/local/rustup /usr/local/rustup
COPY --from=builder /usr/local/cargo /usr/local/cargo
COPY --from=builder /root/.sp1 /root/.sp1

# Copy built binary
COPY --from=builder /workspace/sp1-zkvm/sp1-host/target/release/sp1-host /usr/local/bin/

# Set environment
ENV PATH=/usr/local/cargo/bin:/root/.sp1/bin:/usr/local/bin:$PATH
WORKDIR /workspace

# Copy project files
COPY . /workspace/

# Set default command (execute mode)
CMD ["sp1-host", "--execute"]
