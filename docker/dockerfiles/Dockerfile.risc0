# Risc0 ZKVM Toolchain-Only Dockerfile
# This image contains only the development environment and Risc0 toolchain
# Source code is mounted at runtime and compiled on-demand
# Usage: docker run -v $(pwd):/workspace risc0-toolchain cargo run --release

FROM zkvm-base:latest

# Set CI environment to skip CUDA build
ENV CI=true

# Copy and run Risc0 SDK installer script
COPY scripts/sdk_installers/install_risc0_sdk.sh /tmp/install_risc0_sdk.sh
RUN chmod +x /tmp/install_risc0_sdk.sh && /tmp/install_risc0_sdk.sh \
    && rm -f /tmp/install_risc0_sdk.sh

# Add rzup to PATH
ENV PATH="/root/.risc0/bin:$PATH"

# Set working directory
WORKDIR /workspace

# Set default command to bash (interactive shell)
CMD ["bash"]

