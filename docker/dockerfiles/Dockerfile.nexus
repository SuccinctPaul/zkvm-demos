# Nexus ZKVM Toolchain-Only Dockerfile
# This image contains only the development environment and Nexus toolchain
# Source code is mounted at runtime and compiled on-demand
# Usage: docker run -v $(pwd):/workspace nexus-toolchain cargo run --release -- --nocapture

FROM zkvm-base:latest

# Copy and run Nexus SDK installer script
COPY scripts/sdk_installers/install_nexus_sdk.sh /tmp/install_nexus_sdk.sh
RUN chmod +x /tmp/install_nexus_sdk.sh && /tmp/install_nexus_sdk.sh \
    && rm -f /tmp/install_nexus_sdk.sh

# Set working directory
WORKDIR /workspace

# Set default command to bash (interactive shell)
CMD ["bash"]

