# Multi-stage Nexus ZKVM Dockerfile - Using shared base image
FROM zkvm-base:latest AS base

# Copy and run Nexus SDK installer script
COPY scripts/sdk_installers/install_nexus_sdk.sh /tmp/install_nexus_sdk.sh
RUN chmod +x /tmp/install_nexus_sdk.sh && /tmp/install_nexus_sdk.sh \
    && rm -f /tmp/install_nexus_sdk.sh

# Build stage - separate from runtime
FROM base AS builder

WORKDIR /workspace

# Copy only necessary files for build
COPY Cargo.toml Cargo.lock ./
COPY common/ ./common/
COPY fib/ ./fib/
COPY nexus-zkvm/nexus-host/Cargo.toml ./nexus-zkvm/nexus-host/
COPY nexus-zkvm/nexus-guest/ ./nexus-zkvm/nexus-guest/

# Build dependencies first (better caching)
RUN cd nexus-zkvm/nexus-host && cargo build --release --locked

# Copy source code and build
COPY nexus-zkvm/nexus-host/src/ ./nexus-zkvm/nexus-host/src/
RUN cd nexus-zkvm/nexus-host && cargo build --release --locked

# Runtime stage - minimal image
FROM ubuntu:22.04 AS runtime

# Install only runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy Rust and Nexus tools from builder
COPY --from=builder /usr/local/rustup /usr/local/rustup
COPY --from=builder /usr/local/cargo /usr/local/cargo
COPY --from=builder /root/.cargo/bin/cargo-nexus /usr/local/cargo/bin/
COPY --from=builder /root/.rustup/toolchains/stable-x86_64-unknown-linux-gnu/lib/rustlib/riscv32i-unknown-none-elf /usr/local/rustup/toolchains/stable-x86_64-unknown-linux-gnu/lib/rustlib/riscv32i-unknown-none-elf

# Copy built binary
COPY --from=builder /workspace/nexus-zkvm/nexus-host/target/release/nexus-host /usr/local/bin/

# Set environment
ENV PATH=/usr/local/cargo/bin:/usr/local/bin:$PATH
WORKDIR /workspace

# Copy project files
COPY . /workspace/

# Set default command
CMD ["nexus-host", "--nocapture"]
