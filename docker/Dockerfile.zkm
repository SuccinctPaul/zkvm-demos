# Multi-stage ZKM ZKVM Dockerfile - Using shared base image
FROM zkvm-base:latest AS base

# Copy and run ZKM SDK installer script
COPY scripts/sdk_installers/install_zkm_sdk.sh /tmp/install_zkm_sdk.sh
RUN chmod +x /tmp/install_zkm_sdk.sh && /tmp/install_zkm_sdk.sh \
    && rm -f /tmp/install_zkm_sdk.sh

# Add ZKM to PATH
ENV PATH="/root/.zkm-toolchain/bin:$PATH"

# Build stage - separate from runtime
FROM base AS builder

WORKDIR /workspace

# Copy only necessary files for build
COPY Cargo.toml Cargo.lock ./
COPY common/ ./common/
COPY fib/ ./fib/
COPY zkm-zkvm/zkm-host/Cargo.toml ./zkm-zkvm/zkm-host/
COPY zkm-zkvm/zkm-guest/ ./zkm-zkvm/zkm-guest/

# Build dependencies first (better caching)
RUN cd zkm-zkvm/zkm-host && cargo build --release --locked

# Copy source code and build
COPY zkm-zkvm/zkm-host/src/ ./zkm-zkvm/zkm-host/src/
RUN cd zkm-zkvm/zkm-host && cargo build --release --locked

# Runtime stage - minimal image
FROM ubuntu:22.04 AS runtime

# Install only runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy Rust and ZKM tools from builder
COPY --from=builder /usr/local/rustup /usr/local/rustup
COPY --from=builder /usr/local/cargo /usr/local/cargo
COPY --from=builder /root/.zkm-toolchain /root/.zkm-toolchain

# Copy built binary
COPY --from=builder /workspace/zkm-zkvm/zkm-host/target/release/zkm-host /usr/local/bin/

# Set environment
ENV PATH=/usr/local/cargo/bin:/root/.zkm-toolchain/bin:/usr/local/bin:$PATH
WORKDIR /workspace

# Copy project files
COPY . /workspace/

# Set default command (execute mode)
CMD ["zkm-host", "--execute"]
