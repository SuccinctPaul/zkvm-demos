// Fibonacci computation in Cairo-M
// Computes the nth Fibonacci number using iterative approach
// Optimized for M31 field arithmetic
//
// Usage:
//   cairo-m-compiler --input fibonacci.cm --output fibonacci.json
//   cairo-m-runner fibonacci.json --entrypoint fibonacci --arguments 100

// Main fibonacci function - iterative O(n) implementation
// Input: n (felt) - index in Fibonacci sequence (0-indexed)
// Output: nth Fibonacci number
func fibonacci(n: felt) -> felt {
    // Base cases
    if n == 0 {
        return 0;
    }
    if n == 1 {
        return 1;
    }
    
    // Iterative computation for n >= 2
    let mut a: felt = 0;
    let mut b: felt = 1;
    let mut i: felt = 2;
    
    // Loop until we reach n
    while i <= n {
        let temp: felt = a + b;
        a = b;
        b = temp;
        i = i + 1;
    }
    
    return b;
}

// Entry point - dispatches to fibonacci
func main(input: felt) -> felt {
    return fibonacci(input);
}
