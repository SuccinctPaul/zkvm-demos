// Hash computation in Cairo-M
// Computes a simplified hash of n bytes of data
// Note: For full SHA256, use the sha256 builtin when available
//
// Usage:
//   cairo-m-compiler --input hash.cm --output hash.json
//   cairo-m-runner hash.json --entrypoint hash --arguments 100

// Simple hash function using FNV-1a style algorithm
// Input: n (felt) - number of bytes to process
// Output: hash value as felt
func hash(n: felt) -> felt {
    // FNV offset basis (simplified for M31)
    let mut hash_value: felt = 2166136261;
    
    // FNV prime (simplified)
    let fnv_prime: felt = 16777619;
    
    // Process n bytes of deterministic data
    let mut i: felt = 0;
    while i < n {
        // Generate deterministic byte: i % 256
        let byte: felt = i % 256;
        
        // XOR with byte
        hash_value = hash_value ^ byte;
        
        // Multiply by prime (simplified for M31 field)
        hash_value = (hash_value * fnv_prime) % 2147483647;
        
        i = i + 1;
    }
    
    return hash_value;
}

// Entry point
func main(input: felt) -> felt {
    // Cap input at 1024 bytes
    let n: felt = if input > 1024 { 1024 } else { input };
    return hash(n);
}

