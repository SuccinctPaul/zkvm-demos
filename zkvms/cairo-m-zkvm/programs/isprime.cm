// Prime checking in Cairo-M
// Checks if a number is prime
//
// Usage:
//   cairo-m-compiler --input isprime.cm --output isprime.json
//   cairo-m-runner isprime.json --entrypoint isprime --arguments 17

// Check if n is prime
// Input: n (felt) - number to check
// Output: 1 if prime, 0 if not prime
func isprime(n: felt) -> felt {
    // Handle small cases
    if n < 2 {
        return 0;
    }
    if n == 2 {
        return 1;
    }
    if n == 3 {
        return 1;
    }
    
    // Check if divisible by 2
    if n % 2 == 0 {
        return 0;
    }
    
    // Check odd divisors up to sqrt(n)
    // We iterate up to n/2 for simplicity (less efficient but more cycles)
    let mut i: felt = 3;
    
    while i * i <= n {
        if n % i == 0 {
            return 0;
        }
        i = i + 2;
    }
    
    return 1;
}

// Entry point
func main(input: felt) -> felt {
    return isprime(input);
}

